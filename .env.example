# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://studysync:studysync123@db:5432/studysync

# Backend
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Autenticação — segredo usado para assinar os tokens de login (JWT).
# Gere um valor aleatório forte em produção; nunca reutilize o exemplo abaixo.
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio

# E-mail de Notificações (SMTP)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_email@ethereal.email
EMAIL_PASS=your_password
EMAIL_TO=estudante@exemplo.com

# Frontend
VITE_API_URL=http://localhost:3000/api
