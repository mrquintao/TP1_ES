# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://studysync:studysync123@db:5432/studysync

# Backend
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Autenticação — segredo usado para assinar os tokens de login (JWT).
# Gere um valor aleatório forte em produção; nunca reutilize o exemplo abaixo.
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio

# E-mail de Notificações (SendGrid) — lembrete diário e aviso de "Urgentes".
# SENDGRID_FROM precisa ser um endereço verificado na conta SendGrid
# (Settings → Sender Authentication → Single Sender Verification).
# Sem essas duas variáveis, o app funciona normalmente — só não envia e-mail.
SENDGRID_API_KEY=
SENDGRID_FROM=seu_email_verificado@exemplo.com

# Frontend
VITE_API_URL=http://localhost:3000/api
